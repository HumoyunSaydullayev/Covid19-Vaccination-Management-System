<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User.UserDashboardDoctorsController">
    <children>
        <TableView fx:id="staffs" layoutX="100.0" layoutY="70.0" prefHeight="500.0" prefWidth="1000.0" stylesheets="@../style.css">
            <columns>
                <TableColumn fx:id="firstname" prefWidth="162.0" text="Name surname" />
            <TableColumn fx:id="lastname" prefWidth="162.0" text="Name surname" />
                <TableColumn fx:id="Specialization" minWidth="8.800018310546875" prefWidth="325.0" text="Specialization" />
                <TableColumn fx:id="rating" prefWidth="350.0" text="Number of vaccination" />
            </columns>
        </TableView>
        <Label layoutX="15.0" layoutY="15.0" prefHeight="35.0" prefWidth="314.0" text="Information about vaccines" textFill="WHITE">
            <font>
                <Font name="Century Gothic Bold" size="20.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" layoutX="855.0" layoutY="15.0" prefHeight="35.0" prefWidth="330.0" styleClass="login_check" stylesheets="@../style.css">
            <children>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../../images/search.png" />
                    </image>
                    <HBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </HBox.margin>
                </ImageView>
                <TextField fx:id="keywordTextField" prefHeight="50.0" prefWidth="300.0" promptText="Search">
                    <font>
                        <Font name="Century Gothic Bold" size="16.0" />
                    </font>
                    <effect>
                        <DropShadow />
                    </effect>
                </TextField>
            </children>
            <padding>
                <Insets left="10.0" />
            </padding>
        </HBox>
    </children>
</AnchorPane>
