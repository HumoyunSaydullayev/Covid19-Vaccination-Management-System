<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="800.0" prefWidth="1550.0" style="-fx-background-color: #2F2B43;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User.UserLoginPageController">
    <children>
        <Pane layoutX="400.0" layoutY="412.0" opacity="0.8" prefHeight="240.0" prefWidth="424.0" rotate="40.0" style="-fx-background-color: #FA2C56; -fx-background-radius: 70;" />
        <Pane layoutX="-264.0" layoutY="40.0" opacity="0.8" prefHeight="240.0" prefWidth="424.0" rotate="50.0" style="-fx-background-color: #FA2C56; -fx-background-radius: 70;" />
        <Pane layoutX="450.0" layoutY="-140.0" opacity="0.8" prefHeight="240.0" prefWidth="424.0" rotate="41.6" style="-fx-background-color: #FA2C56; -fx-background-radius: 70;" />
        <Pane layoutX="475.0" layoutY="304.0" prefHeight="350.0" prefWidth="600.0" styleClass="login_page" stylesheets="@../style.css">
            <effect>
                <DropShadow />
            </effect>
            <children>
                <HBox fx:id="passport_hbox" alignment="CENTER" layoutX="150.0" layoutY="58.0" prefHeight="56.0" prefWidth="330.0" styleClass="login_check" stylesheets="@../style.css">
                    <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/login_user.png" />
                            </image>
                        </ImageView>
                        <TextField fx:id="passport" prefHeight="50.0" prefWidth="300.0" promptText="Passport seria and number">
                            <font>
                                <Font name="Century Gothic Bold" size="16.0" />
                            </font>
                            <effect>
                                <DropShadow />
                            </effect>
                        </TextField>
                    </children>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </HBox>
                <HBox fx:id="jshir_hbox" alignment="CENTER" layoutX="150.0" layoutY="171.0" prefHeight="56.0" prefWidth="330.0" styleClass="login_check" stylesheets="@../style.css">
                    <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/login_lock.png" />
                            </image>
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </ImageView>
                        <PasswordField fx:id="captcha" prefHeight="50.0" prefWidth="300.0" promptText="Captcha">
                            <font>
                                <Font name="Century Gothic Bold" size="16.0" />
                            </font>
                        </PasswordField>
                    </children>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </HBox>
                <Label fx:id="error_passport" layoutX="184.0" layoutY="120.0" prefHeight="16.0" prefWidth="293.0" text="*Passport seria and number error" textFill="WHITE">
                    <font>
                        <Font name="Arial Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                    </padding>
                </Label>
                <Label fx:id="error_captcha" layoutX="184.0" layoutY="228.0" prefHeight="16.0" prefWidth="288.0" text="*captcha error" textFill="WHITE">
                    <font>
                        <Font name="Arial Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                    </padding>
                </Label>
                <Button fx:id="login" layoutX="330.0" layoutY="274.0" mnemonicParsing="false" onAction="#Login" prefHeight="50.0" prefWidth="150.0" styleClass="login_button" stylesheets="@../style.css" text="Login" textFill="WHITE">
                    <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" styleClass="my_profile_image">
                            <image>
                                <Image url="@../../../../images/login_enter.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="Century Gothic Bold" size="18.0" />
                    </font>
                    <effect>
                        <DropShadow>
                            <color>
                                <Color red="0.5803921818733215" green="0.019607843831181526" blue="0.019607843831181526" />
                            </color>
                        </DropShadow>
                    </effect>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                <Button fx:id="clear" layoutX="150.0" layoutY="274.0" mnemonicParsing="false" onAction="#Clear" prefHeight="50.0" prefWidth="150.0" styleClass="login_button" stylesheets="@../style.css" text="Clear" textFill="WHITE">
                    <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" styleClass="my_profile_image">
                            <image>
                                <Image url="@../../../../images/login_clear.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="Century Gothic Bold" size="18.0" />
                    </font>
                    <effect>
                        <DropShadow>
                            <color>
                                <Color red="0.5803921818733215" green="0.019607843831181526" blue="0.019607843831181526" />
                            </color>
                        </DropShadow>
                    </effect>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            <Label fx:id="code" layoutX="192.0" layoutY="147.0" prefHeight="20.0" prefWidth="89.0" text="Captcha" textFill="WHITE">
               <font>
                  <Font name="Century Gothic Bold" size="18.0" />
               </font>
            </Label>
