        </Pane>
        <Pane layoutX="1040.0" layoutY="149.0" opacity="0.8" prefHeight="240.0" prefWidth="424.0" rotate="40.0" style="-fx-background-color: #FA2C56; -fx-background-radius: 70;" />
        <Pane layoutX="475.0" layoutY="41.0" prefHeight="150.0" prefWidth="600.0" styleClass="name_of_app" stylesheets="@../style.css">
            <children>
                <Label layoutX="46.0" layoutY="52.0" text="Covid-19 vaccination system" textFill="WHITE">
                    <font>
                        <Font name="Century Gothic Bold" size="36.0" />
                    </font>
                </Label>
            </children>
            <effect>
                <DropShadow />
            </effect>
        </Pane>
        <ImageView fitHeight="173.0" fitWidth="184.0" layoutX="102.0" layoutY="421.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../images/virus.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="1131.0" layoutY="250.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../images/coronavirus.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="1312.0" layoutY="594.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../images/virus 1.png" />
            </image>
        </ImageView>
        <Pane fx:id="main_page" layoutX="1462.0" layoutY="11.0" prefHeight="60.0" prefWidth="60.0" styleClass="admin_most_inner_pane" stylesheets="@../style.css">
            <effect>
                <DropShadow />
            </effect>
            <children>
                <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="5.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../../images/home.png" />
                    </image>
                </ImageView>
            </children>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Pane>
    </children>
</AnchorPane>
