                  <Font name="Arial Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </padding>
            </Label>
            <Label fx:id="error_password" layoutX="184.0" layoutY="220.0" prefHeight="16.0" prefWidth="288.0" text="*Username error" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </padding>
            </Label>
            <Button fx:id="login" layoutX="330.0" layoutY="270.0" mnemonicParsing="false" onAction="#Login" prefHeight="50.0" prefWidth="150.0" styleClass="login_button" stylesheets="@../style.css" text="Login" textFill="WHITE">
