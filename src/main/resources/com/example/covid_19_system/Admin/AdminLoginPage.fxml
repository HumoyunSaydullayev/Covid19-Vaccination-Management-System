               <effect>
                  <DropShadow>
                     <color>
                        <Color red="0.5803921818733215" green="0.019607843831181526" blue="0.019607843831181526" />
                     </color>
                  </DropShadow>
               </effect>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="clear" layoutX="150.0" layoutY="270.0" mnemonicParsing="false" onAction="#Clear" prefHeight="50.0" prefWidth="150.0" styleClass="login_button" stylesheets="@../style.css" text="Clear" textFill="WHITE">
