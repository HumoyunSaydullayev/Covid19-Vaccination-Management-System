         <children>
            <HBox fx:id="user_hbox" alignment="CENTER" layoutX="150.0" layoutY="58.0" prefHeight="56.0" prefWidth="330.0" styleClass="login_check" stylesheets="@../style.css">
               <children>
                  <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../images/login_user.png" />
                     </image>
                  </ImageView>
                  <TextField fx:id="username" prefHeight="50.0" prefWidth="300.0" promptText="Username">
                     <font>
                        <Font name="Century Gothic Bold" size="16.0" />
                     </font>
                     <effect>
                        <DropShadow />
                     </effect>
                  </TextField>
               </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
            </HBox>
            <HBox fx:id="password_hbox" alignment="CENTER" layoutX="150.0" layoutY="161.0" prefHeight="56.0" prefWidth="330.0" styleClass="login_check" stylesheets="@../style.css">
               <children>
                  <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../images/login_lock.png" />
                     </image>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </ImageView>
                   <PasswordField fx:id="password" prefHeight="50.0" prefWidth="300.0" promptText="Password">
                     <font>
                        <Font name="Century Gothic Bold" size="16.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="2.0" />
                     </HBox.margin>
                  </PasswordField>
               </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
            </HBox>
            <Label fx:id="error_username" layoutX="184.0" layoutY="120.0" prefHeight="16.0" prefWidth="293.0" text="*Username error" textFill="WHITE">
